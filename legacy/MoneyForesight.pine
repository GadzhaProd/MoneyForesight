indicator('MoneyForesight', overlay=true)



showcs = input(true, 'Plot Chandelier Stop')



//input variables

int Length = 22  //input(title="Look Back Period", type=integer, defval=22)

int ATRPeriod = 22  //input(title="ATR Period", type=integer, defval=22)

int Mult = 3  //input(title="ATR Multiplier", type=integer, defval=3)



//calculate stop value

short_stop = ta.lowest(Length) + Mult * ta.atr(ATRPeriod)

long_stop = ta.highest(Length) - Mult * ta.atr(ATRPeriod)



float shortvs = 0

float longvs = 0

shortvs := na(shortvs[1]) ? short_stop : close > shortvs[1] ? short_stop : math.min(short_stop, shortvs[1])

longvs := na(longvs[1]) ? long_stop : close < longvs[1] ? long_stop : math.max(long_stop, longvs[1])



longswitch = close >= shortvs[1] and close[1] < shortvs[1] ? 1 : 0

shortswitch = close <= longvs[1] and close[1] > longvs[1] ? 1 : 0



float pc = 0.0

float direction = na

iff_1 = direction[1] >= 0 and shortswitch ? -1 : direction[1]

iff_2 = direction[1] <= 0 and longswitch ? 1 : iff_1

direction := na(direction[1]) ? 0 : iff_2

pc := direction > 0 ? longvs : shortvs



var clr = color.white

if direction > 0

    clr := color.aqua

    clr

else

    clr := color.fuchsia

    clr





Plot01 = plot(showcs ? pc :na, color=color.new(clr, 0), title="CS Circles", style=plot.style_circles, linewidth=2)

Plot02 =plot(showcs ? pc :na, color=color.new(clr, 0), title="CS Lines",style=plot.style_line, linewidth=2)



