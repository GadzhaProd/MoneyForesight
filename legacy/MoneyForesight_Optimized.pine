//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// АРХИВ. Файл НЕ поддерживается и НЕ является рабочим исходником проекта.
// Актуальные скрипты: MoneyForesight_v3.pine (индикатор) и
// MoneyForesight_strategy.pine (стратегия) в корне репозитория.
// Известные дефекты перечислены в legacy/README.md и в находках 20-23
// код-ревью docs/reviews/2026-09-08-code-review.md. Правки сюда не вносятся.
// Компилируется, но содержит известные логические дефекты (см. README).
// ─────────────────────────────────────────────────────────────────────────────
indicator('MoneyForesight', overlay=true, max_bars_back=500)

// ============================================================================
// INPUTS - Chandelier Stop
// ============================================================================
showcs = input.bool(true, 'Plot Chandelier Stop', group="Chandelier Stop")
cs_length = input.int(22, "Look Back Period", minval=1, group="Chandelier Stop")
cs_atr_period = input.int(22, "ATR Period", minval=1, group="Chandelier Stop")
cs_mult = input.float(3.0, "ATR Multiplier", minval=0.1, group="Chandelier Stop")

// ============================================================================
// CHANDELIER STOP CALCULATION
// ============================================================================
short_stop = ta.lowest(cs_length) + cs_mult * ta.atr(cs_atr_period)
long_stop = ta.highest(cs_length) - cs_mult * ta.atr(cs_atr_period)

var float shortvs = na
var float longvs = na

shortvs := na(shortvs[1]) ? short_stop : close > shortvs[1] ? short_stop : math.min(short_stop, shortvs[1])
longvs := na(longvs[1]) ? long_stop : close < longvs[1] ? long_stop : math.max(long_stop, longvs[1])

longswitch = close >= shortvs[1] and close[1] < shortvs[1]
shortswitch = close <= longvs[1] and close[1] > longvs[1]

var float direction = 0.0
direction := na(direction[1]) ? 0 : 
             direction[1] >= 0 and shortswitch ? -1 : 
             direction[1] <= 0 and longswitch ? 1 : 
             direction[1]

pc = direction > 0 ? longvs : shortvs
cs_color = direction > 0 ? color.aqua : color.fuchsia

plot(showcs ? pc : na, color=color.new(cs_color, 0), title="CS Circles", style=plot.style_circles, linewidth=2)
plot(showcs ? pc : na, color=color.new(cs_color, 0), title="CS Lines", style=plot.style_line, linewidth=2)

// ============================================================================
// INPUTS - EMA Lines
// ============================================================================
show_ema = input.bool(true, "Show EMA Lines", group="EMA Settings")
ema3_len = input.int(3, "EMA 3 Length", minval=1, group="EMA Settings")
ema5_len = input.int(5, "EMA 5 Length", minval=1, group="EMA Settings")
ema9_len = input.int(9, "EMA 9 Length", minval=1, group="EMA Settings")
ema_source = input.source(close, "EMA Source", group="EMA Settings")
ema3_offset = input.int(0, "EMA 3 Offset", minval=-500, maxval=500, group="EMA Settings")
ema5_offset = input.int(0, "EMA 5 Offset", minval=-500, maxval=500, group="EMA Settings")
ema9_offset = input.int(0, "EMA 9 Offset", minval=-500, maxval=500, group="EMA Settings")
ema_color = input.color(color.blue, "EMA Color", group="EMA Settings")

// ============================================================================
// EMA CALCULATIONS
// ============================================================================
ema3 = ta.ema(ema_source, ema3_len)
ema5 = ta.ema(ema_source, ema5_len)
ema9 = ta.ema(ema_source, ema9_len)

plot(show_ema ? ema3 : na, title="EMA3", color=ema_color, offset=ema3_offset)
plot(show_ema ? ema5 : na, title="EMA5", color=ema_color, offset=ema5_offset)
plot(show_ema ? ema9 : na, title="EMA9", color=ema_color, offset=ema9_offset)

// ============================================================================
// INPUTS - Beta Distribution Filter
// ============================================================================
show_filter = input.bool(true, "Show Beta Filter", group="Beta Filter")
filter_length = input.int(50, "Filter Length", minval=2, maxval=200, group="Beta Filter")
filter_beta = input.float(3.0, "Beta (-Lag)", minval=1, maxval=10, group="Beta Filter")
filter_alpha = input.float(3.0, "Alpha (+Lag)", minval=1, maxval=10, group="Beta Filter")
filter_source = input.source(close, "Filter Source", group="Beta Filter")

// ============================================================================
// BETA DISTRIBUTION FILTER CALCULATION
// ============================================================================
var array<float> b_weights = array.new<float>()
var array<color> color_gradient = array.new<color>()

// Initialize weights and color gradient once
if barstate.isfirst
    // Calculate beta distribution weights
    for i = 0 to filter_length - 1
        x = i / math.max(filter_length - 1, 1)
        w = math.pow(x, filter_alpha - 1) * math.pow(1 - x, filter_beta - 1)
        array.push(b_weights, w)
    
    // Generate color gradient programmatically (red to yellow to green)
    // 200 colors from #FF1100 (red) to #30FF85 (green)
    for i = 0 to 199
        ratio = i / 199.0
        int r = 255
        int g = 255
        int b = 0
        if ratio < 0.5
            // Red to yellow transition
            r := 255
            g := math.round(17 + (255 - 17) * (ratio * 2))
            b := 0
        else
            // Yellow to green transition
            r := math.round(255 - (255 - 48) * ((ratio - 0.5) * 2))
            g := 255
            b := math.round((ratio - 0.5) * 2 * 133)
        array.push(color_gradient, color.rgb(r, g, b))

// Calculate weighted sum
den = array.sum(b_weights)
sum = 0.0
float filt = na
if den > 0
    for i = 0 to math.min(filter_length - 1, array.size(b_weights) - 1)
        sum += filter_source[i] * array.get(b_weights, i)
    filt := sum / den

// Calculate RSI-based color index (outside conditional scope)
os = ta.rsi(filt, filter_length) / 100
color_idx = math.min(199, math.max(0, math.round(os * 199)))
filt_color = array.get(color_gradient, color_idx)

plot(show_filter ? filt : na, 'Beta Filter', filt_color, 2)

// ============================================================================
// INPUTS - ADX/MACD Signals
// ============================================================================
show_signals = input.bool(true, "Show BUY/SELL Signals", group="ADX/MACD Signals")
show_candle_colors = input.bool(true, "Show Candle Colors", group="ADX/MACD Signals")
adx_length = input.int(14, "ADX Length", minval=1, group="ADX/MACD Signals")
adx_smoothing = input.int(10, "ADX Smoothing", minval=1, group="ADX/MACD Signals")
macd_source = input.source(close, "MACD Source", group="ADX/MACD Signals")
macd_fast = input.int(12, "MACD Fast Length", minval=1, group="ADX/MACD Signals")
macd_slow = input.int(26, "MACD Slow Length", minval=1, group="ADX/MACD Signals")
macd_signal = input.int(9, "MACD Signal Length", minval=1, group="ADX/MACD Signals")
signal_color_up = input.color(color.green, "Up Candle Color", group="ADX/MACD Signals")
signal_color_down = input.color(color.red, "Down Candle Color", group="ADX/MACD Signals")

// ============================================================================
// ADX AND MACD CALCULATIONS
// ============================================================================
[diplus, diminus, adx] = ta.dmi(adx_length, adx_smoothing)
[macdline, signalline, histline] = ta.macd(macd_source, macd_fast, macd_slow, macd_signal)

// ============================================================================
// TRADE SIGNAL CALCULATION
// ============================================================================
longcheck = diplus > diminus and macdline > signalline
shortcheck = diminus > diplus and signalline > macdline

var int trade = 0

if trade == 0 and longcheck
    trade := 1
else if trade == 0 and shortcheck
    trade := -1
else if trade == 1 and shortcheck
    trade := -1
else if trade == -1 and longcheck
    trade := 1
else
    trade := trade[1]

// ============================================================================
// PLOT SIGNALS
// ============================================================================
candle_color = longcheck ? signal_color_up : shortcheck ? signal_color_down : na
plotcandle(open, high, low, close, color=show_candle_colors ? candle_color : na)

plotshape(trade[1] != 1 and trade == 1 and show_signals, style=shape.labelup, text='BUY', 
          textcolor=color.white, color=color.green, size=size.small, location=location.belowbar)
plotshape(trade[1] != -1 and trade == -1 and show_signals, style=shape.labeldown, text='SELL', 
          textcolor=color.white, color=color.red, size=size.small, location=location.abovebar)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(trade[1] != 1 and trade == 1, "LONG", "Long signal triggered")
alertcondition(trade[1] != -1 and trade == -1, "SHORT", "Short signal triggered")

// ============================================================================
// INPUTS - Support/Resistance Levels
// ============================================================================
sr_tf = input.timeframe('D', "Higher Time Frame", group="Support/Resistance")
sr_prd = input.int(5, "Pivot Period", minval=1, maxval=30, tooltip="Used while calculating Pivot Points, checks left&right bars", group="Support/Resistance")
sr_loopback = input.int(250, "Loopback Period", minval=50, maxval=400, tooltip="While calculating S/R levels it checks Pivots in Loopback Period", group="Support/Resistance")
sr_channel_width = input.float(6.0, "Maximum Channel Width %", minval=1, maxval=15, tooltip="Calculated using Highest/Lowest levels in 300 bars", group="Support/Resistance")
sr_min_strength = input.int(2, "Minimum Strength", minval=1, tooltip="Channel must contain at least X Pivot Points", group="Support/Resistance")
sr_max_count = input.int(6, "Maximum Number of S/R", minval=1, maxval=10, tooltip="Maximum number of Support/Resistance Channels to Show", group="Support/Resistance")
sr_show_fit = input.bool(true, "Show S/Rs that fits the Chart", group="Support/Resistance")
sr_show_table = input.bool(true, "Show S/R channels in a table", group="Support/Resistance")
sr_table_pos_y = input.string('bottom', 'Chart Location', options=['bottom', 'middle', 'top'], inline='chartpos', group="Support/Resistance")
sr_table_pos_x = input.string('left', '', options=['left', 'center', 'right'], inline='chartpos', group="Support/Resistance")
sr_res_color = input.color(color.new(color.red, 75), "Resistance Color", group="Support/Resistance")
sr_sup_color = input.color(color.new(color.lime, 75), "Support Color", group="Support/Resistance")
sr_in_channel_color = input.color(color.new(color.gray, 75), "Color When Price in Channel", group="Support/Resistance")

// ============================================================================
// SUPPORT/RESISTANCE CALCULATION FUNCTIONS
// ============================================================================
get_highlow() =>
    var hlmatrix = matrix.new<float>(sr_loopback, 2, 0.0)
    if barstate.islast
        for x = 0 to sr_loopback - 1
            matrix.set(hlmatrix, x, 0, high[x])
            matrix.set(hlmatrix, x, 1, low[x])
    hlmatrix

hlmatrix = request.security(syminfo.tickerid, sr_tf, get_highlow(), lookahead=barmerge.lookahead_on)

if na(hlmatrix)
    runtime.error('Invalid Time Frame selected. Please choose a valid higher timeframe.')
if matrix.rows(hlmatrix) < sr_prd * 10
    runtime.error('Insufficient candles on selected timeframe. Please choose a different timeframe.')

get_pivotvals(hlmatrix) =>
    highs = matrix.col(hlmatrix, 0)
    lows = matrix.col(hlmatrix, 1)
    pivotvals = array.new<float>()
    
    if array.size(highs) > sr_prd * 2 and array.size(lows) > sr_prd * 2
        for x = sr_prd to array.size(highs) - sr_prd - 1
            high_slice = array.slice(highs, x - sr_prd, x + sr_prd + 1)
            low_slice = array.slice(lows, x - sr_prd, x + sr_prd + 1)
            
            if array.size(high_slice) > 0 and array.size(low_slice) > 0
                if array.get(highs, x) >= array.max(high_slice)
                    array.push(pivotvals, array.get(highs, x))
                if array.get(lows, x) <= array.min(low_slice)
                    array.push(pivotvals, array.get(lows, x))
    pivotvals

get_sr_vals(pivotvals, cwidth, ind) =>
    if ind >= array.size(pivotvals)
        [na, na, 0]
    else
        float lo = array.get(pivotvals, ind)
        float hi = lo
        int numpp = 0
        
        for y = 0 to array.size(pivotvals) - 1
            float cpp = array.get(pivotvals, y)
            float wdth = cpp <= hi ? hi - cpp : cpp - lo
            if wdth <= cwidth
                if cpp <= hi
                    lo := math.min(lo, cpp)
                else
                    hi := math.max(hi, cpp)
                numpp := numpp + 20
        [hi, lo, numpp]

var suportresistance = array.new<float>(20, 0.0)

changeit(suportresistance, x, y) =>
    if x * 2 + 1 < array.size(suportresistance) and y * 2 + 1 < array.size(suportresistance)
        tmp_hi = array.get(suportresistance, y * 2)
        tmp_lo = array.get(suportresistance, y * 2 + 1)
        array.set(suportresistance, y * 2, array.get(suportresistance, x * 2))
        array.set(suportresistance, y * 2 + 1, array.get(suportresistance, x * 2 + 1))
        array.set(suportresistance, x * 2, tmp_hi)
        array.set(suportresistance, x * 2 + 1, tmp_lo)

get_level(suportresistance, ind) =>
    float ret = na
    if ind < array.size(suportresistance) and array.get(suportresistance, ind) != 0
        ret := array.get(suportresistance, ind)
    ret

get_color(suportresistance, ind) =>
    color ret = na
    if ind + 1 < array.size(suportresistance) and array.get(suportresistance, ind) != 0
        hi_level = array.get(suportresistance, ind)
        lo_level = array.get(suportresistance, ind + 1)
        ret := hi_level > close and lo_level > close ? sr_res_color :
               hi_level < close and lo_level < close ? sr_sup_color :
               sr_in_channel_color
    ret

// Optimized visible bars calculation
var int visible_bars = 500
if barstate.islast
    visible_bars := math.min(500, bar_index + 1)

chart_highest = ta.highest(visible_bars)
chart_lowest = ta.lowest(visible_bars)
chart_range = chart_highest - chart_lowest
chart_highest := chart_highest + chart_range * 0.05
chart_lowest := chart_lowest - chart_range * 0.05

var bool resistancebroken = false
var bool supportbroken = false

// ============================================================================
// MAIN S/R CALCULATION (Only on last bar for performance)
// ============================================================================
if barstate.islast
    pivotvals = get_pivotvals(hlmatrix)
    
    if array.size(pivotvals) > 0
        prdhighest = array.max(pivotvals)
        prdlowest = array.min(pivotvals)
        cwidth = (prdhighest - prdlowest) * sr_channel_width / 100
        
        supres = array.new<float>()
        stren = array.new<float>(10, 0.0)
        
        // Calculate S/R levels and strengths
        for x = 0 to array.size(pivotvals) - 1
            [hi, lo, strength] = get_sr_vals(pivotvals, cwidth, x)
            if not na(hi) and not na(lo)
                array.push(supres, strength)
                array.push(supres, hi)
                array.push(supres, lo)
        
        // Add strength from OHLC touches (optimized - limit to visible bars)
        max_bars_check = math.min(500, bar_index + 1)
        for x = 0 to math.min(array.size(pivotvals) - 1, (array.size(supres) / 3) - 1)
            h = array.get(supres, x * 3 + 1)
            l = array.get(supres, x * 3 + 2)
            s = 0
            
            if not na(h) and not na(l)
                for y = 0 to max_bars_check - 1
                    if (high[y] <= h and high[y] >= l) or
                       (low[y] <= h and low[y] >= l) or
                       (open[y] <= h and open[y] >= l) or
                       (close[y] <= h and close[y] >= l)
                        s := s + 1
                array.set(supres, x * 3, array.get(supres, x * 3) + s)
        
        // Reset and find strongest S/R levels
        array.fill(suportresistance, 0.0)
        src = 0
        
        for x = 0 to array.size(pivotvals) - 1
            if src >= 10
                break
            
            stv = -1.0
            stl = -1
            
            for y = 0 to math.min(array.size(pivotvals) - 1, (array.size(supres) / 3) - 1)
                strength_val = array.get(supres, y * 3)
                if strength_val > stv and strength_val >= sr_min_strength * 20
                    stv := strength_val
                    stl := y
            
            if stl >= 0
                hh = array.get(supres, stl * 3 + 1)
                ll = array.get(supres, stl * 3 + 2)
                
                if not na(hh) and not na(ll)
                    array.set(suportresistance, src * 2, hh)
                    array.set(suportresistance, src * 2 + 1, ll)
                    array.set(stren, src, stv)
                    
                    // Mark included pivot points
                    for y = 0 to math.min(array.size(pivotvals) - 1, (array.size(supres) / 3) - 1)
                        y_hi = array.get(supres, y * 3 + 1)
                        y_lo = array.get(supres, y * 3 + 2)
                        if not na(y_hi) and not na(y_lo)
                            if (y_hi <= hh and y_hi >= ll) or (y_lo <= hh and y_lo >= ll)
                                array.set(supres, y * 3, -1.0)
                    
                    src += 1
        
        // Sort S/R by strength (bubble sort - optimized for small arrays)
        for x = 0 to math.min(8, src - 2)
            for y = x + 1 to math.min(9, src - 1)
                if array.get(stren, y) > array.get(stren, x)
                    tmp = array.get(stren, y)
                    array.set(stren, y, array.get(stren, x))
                    array.set(stren, x, tmp)
                    changeit(suportresistance, x, y)
        
        // Create table
        var srtable = table.new(position=sr_table_pos_y + '_' + sr_table_pos_x, columns=5, rows=11, frame_width=1, frame_color=color.gray, border_width=1, border_color=color.gray)
        
        if sr_show_table
            table.cell(srtable, 0, 0, text="TF:" + str.tostring(sr_tf) + " Sorted by Strength - MoneyForesight", text_color=color.rgb(230, 20, 100), bgcolor=color.yellow)
            table.merge_cells(srtable, 0, 0, 3, 0)
        
        // Display S/R channels
        var srchannels = array.new<box>(10)
        rowindex = 1
        
        for x = 0 to math.min(9, sr_max_count - 1)
            box.delete(array.get(srchannels, x))
            srcol = get_color(suportresistance, x * 2)
            
            if not na(srcol)
                hi_level = get_level(suportresistance, x * 2)
                lo_level = get_level(suportresistance, x * 2 + 1)
                
                if not na(hi_level) and not na(lo_level)
                    if not sr_show_fit or (lo_level <= chart_highest and hi_level >= chart_lowest)
                        array.set(srchannels, x, box.new(left=bar_index - 300, top=hi_level, right=bar_index + 1, bottom=lo_level, border_color=srcol, border_width=1, extend=extend.both, bgcolor=srcol))
                    
                    if sr_show_table
                        srtext = srcol == sr_res_color ? "Resistance" : "Support"
                        bgcol = srcol == sr_res_color ? color.rgb(200, 0, 0) : color.rgb(0, 200, 0)
                        txtcol = srcol == sr_res_color ? color.white : color.black
                        table.cell(srtable, 0, rowindex, text=str.tostring(rowindex), text_color=txtcol, bgcolor=bgcol)
                        table.cell(srtable, 1, rowindex, text=srtext, text_color=txtcol, bgcolor=bgcol)
                        table.cell(srtable, 2, rowindex, text=str.tostring(math.round_to_mintick(lo_level)), text_color=txtcol, bgcolor=bgcol)
                        table.cell(srtable, 3, rowindex, text=str.tostring(math.round_to_mintick(hi_level)), text_color=txtcol, bgcolor=bgcol)
                        rowindex += 1
        
        // Check for S/R breaks
        not_in_a_channel = true
        for x = 0 to math.min(9, sr_max_count - 1)
            hi_level = get_level(suportresistance, x * 2)
            lo_level = get_level(suportresistance, x * 2 + 1)
            if not na(hi_level) and not na(lo_level)
                if close <= hi_level and close >= lo_level
                    not_in_a_channel := false
                    break
        
        if not_in_a_channel
            for x = 0 to math.min(9, sr_max_count - 1)
                hi_level = get_level(suportresistance, x * 2)
                lo_level = get_level(suportresistance, x * 2 + 1)
                if not na(hi_level) and not na(lo_level)
                    if close[1] <= hi_level and close > hi_level
                        resistancebroken := true
                    if close[1] >= lo_level and close < lo_level
                        supportbroken := true

alertcondition(resistancebroken, title="Resistance Broken", message="Resistance Broken")
alertcondition(supportbroken, title="Support Broken", message="Support Broken")

// ============================================================================
// INPUTS - Fibonacci Retracement & Extension
// ============================================================================
show_fib = input.bool(true, "Show Fibonacci Levels", group="Fibonacci")
fib_pivot_left = input.int(5, "Pivot Left Bars", minval=1, maxval=20, tooltip="Bars to the left for pivot detection", group="Fibonacci")
fib_pivot_right = input.int(5, "Pivot Right Bars", minval=1, maxval=20, tooltip="Bars to the right for pivot detection", group="Fibonacci")
fib_max_swings = input.int(3, "Max Active Swings", minval=1, maxval=5, tooltip="Maximum number of Fibonacci sets to display", group="Fibonacci")
fib_show_retrace = input.bool(true, "Show Retracement Levels", group="Fibonacci")
fib_show_extension = input.bool(true, "Show Extension Levels", group="Fibonacci")
fib_confluence_tolerance = input.float(0.5, "S/R Confluence Tolerance %", minval=0.1, maxval=5.0, tooltip="Distance % for Fibonacci-S/R confluence detection", group="Fibonacci")
fib_show_confluence = input.bool(true, "Highlight Confluence Zones", group="Fibonacci")
fib_line_color = input.color(color.new(color.orange, 30), "Fibonacci Line Color", group="Fibonacci")
fib_confluence_color = input.color(color.new(color.yellow, 50), "Confluence Zone Color", group="Fibonacci")
fib_alert_key_levels = input.bool(true, "Alert on Key Levels", group="Fibonacci")

// Fibonacci levels (retracement and extension) - initialize once
var fib_retrace = array.new<float>()
var fib_extension = array.new<float>()

if barstate.isfirst
    array.push(fib_retrace, 0.236)
    array.push(fib_retrace, 0.382)
    array.push(fib_retrace, 0.5)
    array.push(fib_retrace, 0.618)
    array.push(fib_retrace, 0.786)
    array.push(fib_extension, 1.272)
    array.push(fib_extension, 1.414)
    array.push(fib_extension, 1.618)
    array.push(fib_extension, 2.0)
    array.push(fib_extension, 2.618)

// ============================================================================
// FIBONACCI SWING DETECTION
// ============================================================================
var array<int> swing_high_bars = array.new<int>()
var array<float> swing_high_prices = array.new<float>()
var array<int> swing_low_bars = array.new<int>()
var array<float> swing_low_prices = array.new<float>()

// Detect swing highs and lows
swing_high = ta.pivothigh(high, fib_pivot_left, fib_pivot_right)
swing_low = ta.pivotlow(low, fib_pivot_left, fib_pivot_right)

// Store new swings (keep only recent ones for performance)
if not na(swing_high)
    swing_bar = bar_index[fib_pivot_right]
    array.unshift(swing_high_bars, swing_bar)
    array.unshift(swing_high_prices, swing_high)
    // Keep only the most recent swings
    while array.size(swing_high_bars) > fib_max_swings
        array.pop(swing_high_bars)
        array.pop(swing_high_prices)

if not na(swing_low)
    swing_bar = bar_index[fib_pivot_right]
    array.unshift(swing_low_bars, swing_bar)
    array.unshift(swing_low_prices, swing_low)
    // Keep only the most recent swings
    while array.size(swing_low_bars) > fib_max_swings
        array.pop(swing_low_bars)
        array.pop(swing_low_prices)

// ============================================================================
// FIBONACCI CALCULATION FUNCTIONS
// ============================================================================
calc_fib_levels(swing_high_price, swing_low_price, is_uptrend) =>
    fib_levels = array.new<float>()
    price_range = math.abs(swing_high_price - swing_low_price)
    
    if price_range > 0 and array.size(fib_retrace) > 0
        if is_uptrend
            // Uptrend: calculate retracements from high to low
            base_price = swing_high_price
            for i = 0 to array.size(fib_retrace) - 1
                if i < array.size(fib_retrace)
                    fib_level = base_price - (price_range * array.get(fib_retrace, i))
                    array.push(fib_levels, fib_level)
            
            // Extensions above the high
            if fib_show_extension and array.size(fib_extension) > 0
                for i = 0 to array.size(fib_extension) - 1
                    if i < array.size(fib_extension)
                        fib_level = swing_low_price + (price_range * array.get(fib_extension, i))
                        array.push(fib_levels, fib_level)
        else
            // Downtrend: calculate retracements from low to high
            base_price = swing_low_price
            for i = 0 to array.size(fib_retrace) - 1
                if i < array.size(fib_retrace)
                    fib_level = base_price + (price_range * array.get(fib_retrace, i))
                    array.push(fib_levels, fib_level)
            
            // Extensions below the low
            if fib_show_extension and array.size(fib_extension) > 0
                for i = 0 to array.size(fib_extension) - 1
                    if i < array.size(fib_extension)
                        fib_level = swing_high_price - (price_range * array.get(fib_extension, i))
                        array.push(fib_levels, fib_level)
    fib_levels

check_confluence(fib_level, suportresistance) =>
    is_confluent = false
    tolerance_pct = fib_confluence_tolerance / 100.0
    
    for x = 0 to math.min(9, sr_max_count - 1)
        hi_level = get_level(suportresistance, x * 2)
        lo_level = get_level(suportresistance, x * 2 + 1)
        
        if not na(hi_level) and not na(lo_level)
            // Check if Fibonacci level is within S/R channel
            if fib_level >= lo_level and fib_level <= hi_level
                is_confluent := true
                break
            // Check if Fibonacci level is near S/R boundaries
            level_range_check = (hi_level - lo_level) * tolerance_pct
            if math.abs(fib_level - hi_level) <= level_range_check or math.abs(fib_level - lo_level) <= level_range_check
                is_confluent := true
                break
    is_confluent

// ============================================================================
// FIBONACCI VISUALIZATION (Only on last bar for performance)
// ============================================================================
var array<line> fib_lines = array.new<line>()
var array<box> fib_confluence_boxes = array.new<box>()

if show_fib and barstate.islast
    // Clear previous lines and boxes
    for i = 0 to array.size(fib_lines) - 1
        line.delete(array.get(fib_lines, i))
    array.clear(fib_lines)
    
    for i = 0 to array.size(fib_confluence_boxes) - 1
        box.delete(array.get(fib_confluence_boxes, i))
    array.clear(fib_confluence_boxes)
    
    // Process swing pairs for Fibonacci calculations
    swing_count = 0
    
    // Find most recent swing pair (most recent low and high)
    if array.size(swing_low_bars) > 0 and array.size(swing_high_bars) > 0
        // Get most recent swings
        recent_low_bar = array.get(swing_low_bars, 0)
        recent_low_price = array.get(swing_low_prices, 0)
        recent_high_bar = array.get(swing_high_bars, 0)
        recent_high_price = array.get(swing_high_prices, 0)
        
        // Determine trend direction and calculate Fibonacci
        if not na(recent_low_bar) and not na(recent_high_bar) and not na(recent_low_price) and not na(recent_high_price)
            
            // Uptrend: low before high
            if recent_low_bar < recent_high_bar and recent_low_price < recent_high_price
                // Uptrend Fibonacci
                fib_levels = calc_fib_levels(recent_high_price, recent_low_price, true)
                
                // Draw retracement levels
                if fib_show_retrace
                    for j = 0 to array.size(fib_retrace) - 1
                        if j < array.size(fib_levels)
                            fib_level = array.get(fib_levels, j)
                            is_confluent = check_confluence(fib_level, suportresistance)
                            
                            line_color = is_confluent and fib_show_confluence ? fib_confluence_color : fib_line_color
                            line_width = is_confluent and fib_show_confluence ? 2 : 1
                            
                            fib_line = line.new(x1=recent_low_bar, y1=fib_level, x2=bar_index + 50, y2=fib_level, color=line_color, width=line_width, extend=extend.right, style=line.style_dashed)
                            array.push(fib_lines, fib_line)
                            
                            // Draw confluence zone
                            if is_confluent and fib_show_confluence
                                confluence_box = box.new(left=recent_low_bar, top=fib_level * 1.001, right=bar_index + 50, bottom=fib_level * 0.999, border_color=na, bgcolor=fib_confluence_color, extend=extend.right)
                                array.push(fib_confluence_boxes, confluence_box)
                
                // Draw extension levels
                if fib_show_extension
                    ext_start = array.size(fib_retrace)
                    for j = ext_start to array.size(fib_levels) - 1
                        fib_level = array.get(fib_levels, j)
                        is_confluent = check_confluence(fib_level, suportresistance)
                        
                        line_color = is_confluent and fib_show_confluence ? fib_confluence_color : fib_line_color
                        line_width = is_confluent and fib_show_confluence ? 2 : 1
                        
                        fib_line = line.new(x1=recent_high_bar, y1=fib_level, x2=bar_index + 50, y2=fib_level, color=line_color, width=line_width, extend=extend.right, style=line.style_dotted)
                        array.push(fib_lines, fib_line)
            
            // Downtrend: high before low
            else if recent_high_bar < recent_low_bar and recent_high_price > recent_low_price
                // Downtrend Fibonacci
                fib_levels = calc_fib_levels(recent_high_price, recent_low_price, false)
                
                // Draw retracement levels
                if fib_show_retrace
                    for j = 0 to array.size(fib_retrace) - 1
                        if j < array.size(fib_levels)
                            fib_level = array.get(fib_levels, j)
                            is_confluent = check_confluence(fib_level, suportresistance)
                            
                            line_color = is_confluent and fib_show_confluence ? fib_confluence_color : fib_line_color
                            line_width = is_confluent and fib_show_confluence ? 2 : 1
                            
                            fib_line = line.new(x1=recent_high_bar, y1=fib_level, x2=bar_index + 50, y2=fib_level, color=line_color, width=line_width, extend=extend.right, style=line.style_dashed)
                            array.push(fib_lines, fib_line)
                            
                            // Draw confluence zone
                            if is_confluent and fib_show_confluence
                                confluence_box = box.new(left=recent_high_bar, top=fib_level * 1.001, right=bar_index + 50, bottom=fib_level * 0.999, border_color=na, bgcolor=fib_confluence_color, extend=extend.right)
                                array.push(fib_confluence_boxes, confluence_box)
                
                // Draw extension levels
                if fib_show_extension
                    ext_start = array.size(fib_retrace)
                    for j = ext_start to array.size(fib_levels) - 1
                        fib_level = array.get(fib_levels, j)
                        is_confluent = check_confluence(fib_level, suportresistance)
                        
                        line_color = is_confluent and fib_show_confluence ? fib_confluence_color : fib_line_color
                        line_width = is_confluent and fib_show_confluence ? 2 : 1
                        
                        fib_line = line.new(x1=recent_low_bar, y1=fib_level, x2=bar_index + 50, y2=fib_level, color=line_color, width=line_width, extend=extend.right, style=line.style_dotted)
                        array.push(fib_lines, fib_line)

// ============================================================================
// FIBONACCI ALERTS
// ============================================================================
var bool prev_fib_touched = false

// Check for price touching key Fibonacci levels (0.382, 0.5, 0.618)
fib_key_level_touched = false
float fib_touched_level = na

if show_fib and fib_alert_key_levels
    key_levels = array.new<float>()
    array.push(key_levels, 0.382)
    array.push(key_levels, 0.5)
    array.push(key_levels, 0.618)
    price_tolerance = ta.atr(14) * 0.1 // 10% of ATR for tolerance
    
    for i = 0 to math.min(array.size(swing_low_bars) - 1, array.size(swing_high_bars) - 1, fib_max_swings - 1)
        if fib_key_level_touched
            break
        
        low_price = array.get(swing_low_prices, i)
        high_price = array.get(swing_high_prices, i)
        
        if not na(low_price) and not na(high_price)
            price_range = math.abs(high_price - low_price)
            
            if price_range > 0
                // Check uptrend retracements
                if low_price < high_price
                    for j = 0 to array.size(key_levels) - 1
                        key_level = high_price - (price_range * array.get(key_levels, j))
                        if math.abs(close - key_level) <= price_tolerance
                            fib_key_level_touched := true
                            fib_touched_level := key_level
                            break
                
                // Check downtrend retracements
                if not fib_key_level_touched and high_price > low_price
                    for j = 0 to array.size(key_levels) - 1
                        key_level = low_price + (price_range * array.get(key_levels, j))
                        if math.abs(close - key_level) <= price_tolerance
                            fib_key_level_touched := true
                            fib_touched_level := key_level
                            break

// Alert on new touch (not continuous)
fib_alert_trigger = fib_key_level_touched and not prev_fib_touched
prev_fib_touched := fib_key_level_touched

alertcondition(fib_alert_trigger, title="Fibonacci Key Level", message="Price touched key Fibonacci level")

